<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IS74Wifi.Core\IS74Wifi.Core.csproj" />
    <!-- Exercise the actual App helper without starting/building the interactive EXE. -->
    <Compile Include="..\..\src\IS74Wifi.App\ManualAuthorizationRunner.cs" Link="App\ManualAuthorizationRunner.cs" />
    <None Include="..\fixtures\queued-speedtest.json" Link="fixtures\queued-speedtest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\backend-rate-limited.json" Link="fixtures\backend-rate-limited.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\backend-events.json" Link="fixtures\backend-events.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
